{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/he", "destination": "/therapist-board.html" },
    { "source": "/en", "destination": "/therapist-board-en.html" },
    { "source": "/pt", "destination": "/therapist-board-pt.html" }
  ],
  "rewrites": [
    { "source": "/t/:id", "destination": "/therapist?id=:id" }
  ]
}
